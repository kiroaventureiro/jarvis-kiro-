{
  "name": "Jarvis Kiro - Inventário GitHub (somente leitura)",
  "nodes": [
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "Executar manualmente",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.github.com/user/repos",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "affiliation",
              "value": "owner"
            },
            {
              "name": "per_page",
              "value": "100"
            },
            {
              "name": "sort",
              "value": "updated"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "github-read",
      "name": "Consultar meus repositórios",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => ({json:{name:item.json.name,private:item.json.private,url:item.json.html_url,updatedAt:item.json.updated_at,pushedAt:item.json.pushed_at,description:item.json.description}}));"
      },
      "id": "compact",
      "name": "Reduzir dados",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    }
  ],
  "connections": {
    "Executar manualmente": {
      "main": [
        [
          {
            "node": "Consultar meus repositórios",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Consultar meus repositórios": {
      "main": [
        [
          {
            "node": "Reduzir dados",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}